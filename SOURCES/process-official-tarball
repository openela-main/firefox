#!/bin/sh

function fix-cargo-checksum() {
ARG=$1
FILE=$1
#set -x

#cp $FILE $ARG.backup
for i in $(cat .cargo-checksum.json|jq -r '.files| keys[]'); do
if [ ! -f $i ]; then
  #echo $i non exist
  sed -ie "s|\"$i\":\"[^\"]*\",||" $FILE
else
  SHA=`sha256sum $i | cut -d " " -f1`
  sed -ie "s|\"$i\":\"[^\"]*\"|\"$i\":\"$SHA\"|" $FILE
fi

#echo $i
done
}


